rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/deleted_accounts/$(uid));
    }
    match /game_saves/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['schemaVersion', 'payload'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 65536;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
