{
  "name": "seorilabs-starter-template-game",
  "version": "0.1.0",
  "private": true,
  "description": "Seorilabs Godot game template for Google Play, App Store, and AppsInToss.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tools -p 'test_*.py' -v && python3 tools/check.py",
    "test:e2e": "python3 tools/check.py",
    "test:core": "godot --headless --path godot --script res://tests/game/core_probe.gd",
    "test:godot": "python3 tools/check.py",
    "check:architecture": "python3 tools/check_architecture.py",
    "check:bundle": "python3 tools/bundle.py verify",
    "check:docs": "bash scripts/check_docs.sh",
    "check:platform-switch": "python3 tools/check_local_mode.py",
    "check:release": "bash scripts/check_release_readiness.sh",
    "init:game": "python3 tools/init_game.py",
    "build:godot:web": "bash tools/ensure_godot.sh --with-export-templates && bash scripts/export_godot_web.sh"
  }
}
